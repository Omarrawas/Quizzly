rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if user is an admin
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    // Helper: Check if user is a teacher
    function isTeacher() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // Helper: Check if user is the teacher of a specific subject
    function isTeacherOfSubject(subjectId) {
      return request.auth != null && (
        get(/databases/$(database)/documents/subjects/$(subjectId)).data.teacherId == request.auth.uid ||
        (get(/databases/$(database)/documents/subjects/$(subjectId)).data.teacherIds != null && 
         request.auth.uid in get(/databases/$(database)/documents/subjects/$(subjectId)).data.teacherIds)
      );
    }

    // Helper: Check if user is the owner
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // 1. User Profiles & Sub-collections
    match /users/{userId} {
      // Allow any authenticated user to get profile documents; admin can list all users
      allow get: if request.auth != null;
      allow list: if isAdmin();
      
      // ── Safe profile fields: users can freely update their own profile info ──
      // Covers: name, profilePic, social links, defaults, bio, device info, etc.
      // Explicitly EXCLUDES balance changes (handled below).
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['balance', 'role'])
        || isAdmin();

      // ── Balance Control: enforce valid balance transitions ──
      allow update: if (isOwner(userId) || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['balance'])
        && (
          // Deduction: balance decreases but stays non-negative
          (request.resource.data.balance < resource.data.balance && request.resource.data.balance >= 0)
          ||
          // Credit: only admins or system flows (app logic guards this)
          (request.resource.data.balance > resource.data.balance)
        );
      
      allow create: if request.auth != null; // Allow initial profile creation

      match /{allChildren=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // 2. Global Activation Tracking (user_subjects)
    match /user_subjects/{id} {
      // Allow creation only if recorded userId matches auth
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid
        && (isAdmin() || !('price' in request.resource.data) || request.resource.data.price >= 0);
        
      // Allow any authenticated user (teachers, students, admins) to read/list activations
      allow read: if request.auth != null;

      allow update, delete: if isAdmin();
    }

    // 3. Educational Hierarchy (Publicly readable by all students)
    match /{path=**}/universities/{id} { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /{path=**}/colleges/{id} { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /{path=**}/departments/{id} { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /{path=**}/academic_years/{id} { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /{path=**}/semesters/{id} { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /subjects/{id} { 
      allow read: if request.auth != null; 
      allow update: if isAdmin() || isTeacherOfSubject(id);
      allow create, delete: if isAdmin();
    }
    match /sections/{id} { 
      allow read: if request.auth != null; 
      allow create: if isAdmin() || isTeacherOfSubject(request.resource.data.parentId);
      allow update: if isAdmin() || isTeacherOfSubject(resource.data.parentId);
      allow delete: if isAdmin() || isTeacherOfSubject(resource.data.parentId);
    }
    match /topics/{id} { 
      allow read: if request.auth != null; 
      allow create: if isAdmin() || isTeacherOfSubject(request.resource.data.subjectId);
      allow update: if isAdmin() || isTeacherOfSubject(resource.data.subjectId);
      allow delete: if isAdmin() || isTeacherOfSubject(resource.data.subjectId);
    }
    
    // 4. Questions and Exams
    match /questions/{id} { 
      allow read: if request.auth != null; 
      allow create: if isAdmin() || isTeacherOfSubject(request.resource.data.subjectId);
      allow update: if isAdmin() || isTeacherOfSubject(resource.data.subjectId);
      allow delete: if isAdmin() || isTeacherOfSubject(resource.data.subjectId);
    }
    match /exams/{id} { 
      allow read: if request.auth != null; 
      allow create: if isAdmin() || isTeacherOfSubject(request.resource.data.subjectId);
      allow update: if isAdmin() || isTeacherOfSubject(resource.data.subjectId);
      allow delete: if isAdmin() || isTeacherOfSubject(resource.data.subjectId);
    }
    match /exam_attempts/{id} {
      allow create: if request.auth != null;
      allow get: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // 5. Activation Codes
    match /activation_codes/{id} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      
      // Prevent reusing codes
      allow update: if request.auth != null 
        && resource.data.isUsed == false 
        && request.resource.data.isUsed == true
        && request.resource.data.usedBy == request.auth.uid;
      
      allow create, delete: if isAdmin();
    }
    
    match /activation_batches/{id} { allow read, write: if isAdmin(); }
    
    // 6. Logs & Audits
    match /credit_logs/{id} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Allow admin to list all logs; users can only read their own
      allow get: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow list: if isAdmin();
    }

    // 7. User Activity
    match /quiz_attempts/{id} {
      allow create: if request.auth != null;
      allow read: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /practice_sessions/{id} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /user_history/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    match /battles/{id} {
      allow read, create, update: if request.auth != null;
      allow delete: if isAdmin();
    }
    
    // 8. Reports
    match /question_reports/{id} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (isAdmin() || isTeacherOfSubject(resource.data.subjectId));
      allow update: if isAdmin() || isTeacherOfSubject(resource.data.subjectId);
      allow delete: if isAdmin() || isTeacherOfSubject(resource.data.subjectId);
    }

    // 9. Settings Documents
    match /settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 10. Subject Leagues & History
    match /user_subject_leagues/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && id.startsWith(request.auth.uid + '_');
    }

    match /subject_leagues_history/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && id.startsWith(request.auth.uid + '_');
    }

    // 11. System Settings
    match /system_settings/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // 12. Notifications
    match /notifications/{id} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }
  }
}
